{
  "image": "mcr.microsoft.com/devcontainers/universal:2",
  "forwardPorts": [5081, 3000],
  "portsAttributes": {
    "5081": {
      "label": "Backend API (.NET)",
      "onAutoForward": "openPreview"
    },
    "3000": {
      "label": "Frontend (React)",
      "onAutoForward": "openPreview"
    }
  },
  "postCreateCommand": "cd Admin && dotnet restore && cd .. && npm install",
  "postAttachCommand": "bash start.sh"
}